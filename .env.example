# Copy to .env, or export these variables in your shell.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 only if you have a legal basis and a privacy notice for storing uploaded images.
VERIFACE_STORE_UPLOADS=0
